# AI Co-Scientist Environment Variables
# Copy this file to .env and fill in your API keys
# cp .env.example .env

# =============================================================================
# LLM Providers
# =============================================================================

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Google AI (Gemini) - https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI (optional fallback) - https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# LangSmith (Optional - for LangGraph tracing/debugging)
# =============================================================================

# LangSmith - https://smith.langchain.com/
# Free tier available, useful for debugging agent workflows
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=ai-coscientist

# =============================================================================
# Search & RAG
# =============================================================================

# Tavily Search API - https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key-here

# =============================================================================
# Storage Backend (Phase 4)
# =============================================================================

# Storage backend: "memory" (dev), "postgres" (prod), "cached" (prod + Redis)
STORAGE_BACKEND=memory

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://coscientist:password@localhost:5432/coscientist

# Redis connection string (for caching/task queue)
REDIS_URL=redis://localhost:6379

# =============================================================================
# Vector Storage
# =============================================================================

# ChromaDB (prototyping) - local file path
CHROMA_PERSIST_DIRECTORY=./data/chroma

# =============================================================================
# Model Configuration
# =============================================================================

# LLM Provider: "google" or "openai"
# This determines which model preset is used for all agents
LLM_PROVIDER=google

# -----------------------------------------------------------------------------
# GOOGLE GEMINI MODELS (if LLM_PROVIDER=google)
# -----------------------------------------------------------------------------
# Pricing (USD per 1M tokens): input / output
#   gemini-3-pro-preview:   $2.00 / $12.00  (best quality)
#   gemini-2.5-flash:       $0.30 / $2.50   (balanced)
#   gemini-3-flash-preview: $0.50 / $3.00   (fast)
#   gemini-2.0-flash:       $0.10 / $0.40   (cheapest)

GOOGLE_GENERATION_MODEL=gemini-3-pro-preview
GOOGLE_EVOLUTION_MODEL=gemini-3-pro-preview
GOOGLE_META_REVIEW_MODEL=gemini-3-pro-preview
GOOGLE_REFLECTION_MODEL=gemini-2.5-flash
GOOGLE_RANKING_MODEL=gemini-3-flash-preview
GOOGLE_PROXIMITY_MODEL=gemini-3-flash-preview
GOOGLE_SUPERVISOR_MODEL=gemini-3-flash-preview

# -----------------------------------------------------------------------------
# OPENAI MODELS (if LLM_PROVIDER=openai)
# -----------------------------------------------------------------------------
# Pricing (USD per 1M tokens): input / output
#   gpt-5.1:      $1.25 / $10.00  (best quality for budget)
#   gpt-5:        $1.25 / $10.00  (stable)
#   gpt-5-mini:   $0.25 / $2.00   (balanced)
#   gpt-5-nano:   $0.05 / $0.40   (cheapest)
#   gpt-5.2:      $1.75 / $14.00  (premium, not recommended for budget)
#   gpt-5-pro:    $21.00 / $168.00 (too expensive)

OPENAI_GENERATION_MODEL=gpt-5.1
OPENAI_EVOLUTION_MODEL=gpt-5.1
OPENAI_META_REVIEW_MODEL=gpt-5
OPENAI_REFLECTION_MODEL=gpt-5-mini
OPENAI_RANKING_MODEL=gpt-5-mini
OPENAI_PROXIMITY_MODEL=gpt-5-nano
OPENAI_SUPERVISOR_MODEL=gpt-5-nano

# =============================================================================
# Budget & Cost Tracking
# =============================================================================

# Maximum budget in AUD - system stops when exceeded
BUDGET_LIMIT_AUD=15

# USD to AUD conversion rate (update periodically)
USD_TO_AUD_RATE=1.55

# Path to persist cost tracking data
COST_TRACKING_PATH=./data/cost_tracking.json

# =============================================================================
# System Settings
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum concurrent agent workers
MAX_WORKERS=4

# Tournament settings
INITIAL_ELO_RATING=1200
ELO_K_FACTOR=32

# =============================================================================
# Literature tools (optional)
# =============================================================================

# NCBI API key for PubMed: raises the E-utilities rate limit
# PUBMED_API_KEY=your-ncbi-api-key-here

# Semantic Scholar API key: without one the tool runs anonymously at a low rate limit
# SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key-here

# =============================================================================
# AWS Bedrock (optional provider: LLM_PROVIDER=bedrock)
# =============================================================================
# Authentication uses the standard AWS credential chain (IAM role, profile or the
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables). No Bedrock API key is read.
# BEDROCK_REGION and BEDROCK_INFERENCE_PROFILE_ARNS are read from the process
# environment, so export them (scripts/run_batch.py also loads this file first).

# BEDROCK_REGION=ap-southeast-2

# Optional JSON map from foundation-model ID to an application inference profile
# ARN in your own account. A model missing from the map falls back to its system
# inference profile (see src/llm/bedrock.py).
# BEDROCK_INFERENCE_PROFILE_ARNS={"anthropic.claude-opus-4-8":"arn:aws:bedrock:<region>:<account-id>:application-inference-profile/<profile-id>"}

# Model IDs per agent (defaults are set in src/config.py)
# BEDROCK_GENERATION_MODEL=anthropic.claude-opus-4-8
# BEDROCK_REFLECTION_MODEL=anthropic.claude-sonnet-5
# BEDROCK_RANKING_MODEL=anthropic.claude-sonnet-5
# BEDROCK_EVOLUTION_MODEL=anthropic.claude-opus-4-8
# BEDROCK_META_REVIEW_MODEL=anthropic.claude-opus-4-8
# BEDROCK_SUPERVISOR_MODEL=anthropic.claude-sonnet-5

# =============================================================================
# Per-agent provider and model overrides (optional)
# =============================================================================
# Override LLM_PROVIDER and the model for one agent. Agents: GENERATION,
# REFLECTION, RANKING, EVOLUTION, META_REVIEW, SUPERVISOR. Providers: google,
# openai, bedrock.
# GENERATION_PROVIDER_OVERRIDE=bedrock
# GENERATION_MODEL_OVERRIDE=anthropic.claude-opus-4-8

# =============================================================================
# Run options (optional)
# =============================================================================

# Set to false to skip literature retrieval during generation, and with it the
# DOI checks and observation review. Refutation search in reviews has its own
# switch, ENABLE_REFUTATION_SEARCH.
# ENABLE_WEB_SEARCH=true

# Set to false to skip the evolution agent
# ENABLE_EVOLUTION=true

# Share of BUDGET_AUD kept back for the final meta-review, overview and report
# FINALIZATION_RESERVE_FRACTION=0.05

# Maximum number of reviews shown to the meta-review prompt
# META_REVIEW_MAX_REVIEWS=40
